div#ui-language-control(style='position: fixed; top: 16px; right: 16px; z-index: 100; background: #1c1c1c; color: #eee; padding: 8px; border-radius: 4px;')
  label(for='ui-language')= uiText('Language')
  select#ui-language(onchange='MMGISAuth.switchLanguage(this.value)' style='margin-left: 8px;')
    option(value='zh-CN' selected=uiLocale === 'zh-CN') 简体中文
    option(value='en' selected=uiLocale === 'en') English
