doctype html
- const uiAssetRoot = uiRoot + (uiRoot.endsWith("/") ? "" : "/")
html(lang=uiLocale data-mmgis-root=uiRoot)
  head
    title= uiText("MMGIS / Configure")
    link(rel='shortcut icon' href=uiAssetRoot + 'public/images/logos/logo.png')
    link(type='text/css' rel='stylesheet' href=uiAssetRoot + 'public/adminlogin.css')
    link(type='text/css' rel='stylesheet' href=uiAssetRoot + 'public/fonts/materialdesignicons/css/materialdesignicons.min.css')
    script(type='text/javascript' src=uiAssetRoot + uiLegacyScript)
    script(type='text/javascript' src=uiAssetRoot + 'public/jquery.min.js')
    script(type='text/javascript' src=uiAssetRoot + 'public/adminlogin.js')
    style.
      body { background-color: #1a1a1a; background-image: url(#{uiAssetRoot}public/images/contours.png); }
  body.mmgisScrollbar
    include ui-language.pug
    #backIcon.mdi.mdi-keyboard-backspace.mdi-18px
    #setup
      = uiText("SETUP")
    .container
      img(src=uiAssetRoot + 'public/images/logos/mmgis.png' alt='MMGIS' onClick='back()')
      span#msg.error
      form.box(name='form1')
        h4
          = uiText("Admin")
          span= uiText("Dashboard")
        h5= uiText("Sign in to your account.")
        input#username(type='text' name='username' placeholder=uiText("Username") autocomplete='off')
        input#pwd(type='password' name='password' placeholder=uiText("Password") autocomplete='off')
        input#pwd_retype(type='password' name='password' placeholder=uiText("Retype Password") autocomplete='off')
        div.btn1(onClick='login()')= uiText("Sign in")
        div.version v#{VERSION}
  
